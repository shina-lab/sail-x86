prelude {
  files
    prelude/prelude.sail,
}

core {
  requires prelude

  files
    core/types.sail,
    core/regs.sail,
    core/rflags.sail,
    core/mem.sail,
    core/exceptions.sail,
    core/fp_extern.sail,
    core/x87_regs.sail,
}

helpers {
  requires prelude, core

  files
    helpers/x87.sail,
    helpers/sse_arith.sail,
    helpers/sse_convert.sail,
    helpers/sse_int.sail,
    helpers/sse_mov.sail,
    helpers/gpr.sail,
    helpers/control.sail,
    helpers/string.sail,
    helpers/shift.sail,
    helpers/mov.sail,
    helpers/system.sail,
    helpers/avx.sail,
}

decode {
  requires prelude, core, helpers

  files
    decode/decode_types.sail,
    decode/decode_prefixes.sail,
    decode/decode_modrm.sail,
    decode/decode_alu.sail,
    decode/decode_opmap3.sail,
    decode/decode_x87.sail,
    decode/decode_opmap2.sail,
    decode/decode_groups.sail,
    decode/decode_vex.sail,
    decode/decode_opmap1.sail,
    decode/fetch_execute.sail,
}
