prelude {
  files
    prelude/prelude.sail,
}

core {
  requires prelude

  files
    core/types.sail,
    core/regs.sail,
    core/rflags.sail,
    core/mem.sail,
    core/exceptions.sail,
    core/fp_extern.sail,
    core/x87_regs.sail,
}

helpers {
  requires prelude, core

  files
    helpers/sse_int.sail,
    helpers/string.sail,
    helpers/avx.sail,
}

decode {
  requires prelude, core, helpers

  files
    decode/types.sail,
    decode/decode_prefixes.sail,
    decode/decode_modrm.sail,
    decode/decode_alu.sail,
    decode/decode_x87.sail,
    decode/decode_sse_fp.sail,
    decode/decode_sse_int.sail,
    decode/decode_baseline.sail,
    decode/decode_groups.sail,
    decode/decode_vex.sail,
    decode/decode_dispatch.sail,
    decode/fetch_execute.sail,
}
