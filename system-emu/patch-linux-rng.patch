+static void __init sail_deterministic_crng_early_init(void)
+{
+	size_t i;
+
+	for (i = 0; i < sizeof(base_crng.key); ++i)
+		base_crng.key[i] = (u8)(0xa5 ^ (u8)(i * 29));
+	base_crng.generation = 1;
+	crng_init = CRNG_READY;
+}
