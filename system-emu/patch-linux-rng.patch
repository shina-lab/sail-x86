+/*
+ * SAIL deterministic boot RNG
+ *
+ * For emulator differential debugging we want the boot path to be fully
+ * deterministic. Opt in with the "sail_deterministic_rng" kernel cmdline
+ * parameter; without it this kernel behaves identically to vanilla. When
+ * enabled, all RNG consumers get a fixed byte stream and the CRNG is marked
+ * ready immediately so /dev/urandom and AT_RANDOM do not depend on timing
+ * or entropy collection.
+ */
+static bool sail_deterministic_boot_rng __ro_after_init;
+
+static int __init sail_deterministic_rng_setup(char *str)
+{
+	sail_deterministic_boot_rng = true;
+	return 0;
+}
+early_param("sail_deterministic_rng", sail_deterministic_rng_setup);
+
+static void sail_deterministic_fill(void *buf, size_t len)
+{
+	static const u64 seed = 0x7361696c78663836ULL;
+	u8 *out = buf;
+	size_t i;
+
+	for (i = 0; i < len; ++i)
+		out[i] = (u8)(((seed + (u64)i * 0x9e3779b97f4a7c15ULL) >> ((i & 7) * 8)) & 0xff);
+}
 static ATOMIC_NOTIFIER_HEAD(random_ready_notifier);
 
 /* Control how we warn userspace. */
